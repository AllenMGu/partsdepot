<view class="container">
  <view class="card" style="margin-top: 120rpx;">
    <view class="title">办公用品申请系统</view>
    <view class="subtitle" style="margin-bottom: 24rpx;">请使用办公用品申请系统账号登录</view>

    <input class="input" placeholder="用户名" value="{{username}}" bindinput="onUsernameInput" />
    <input
      class="input"
      password
      placeholder="密码"
      value="{{password}}"
      bindinput="onPasswordInput"
    />
    <button class="btn-primary" loading="{{loading}}" bindtap="handleLogin">登录</button>
  </view>

  <view class="card" style="margin-top: 20rpx;">
    <button class="btn-ghost" bindtap="goApply">匿名提交申请（无需登录）</button>
  </view>
</view>
