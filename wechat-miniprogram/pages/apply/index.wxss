.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d8e0ea;
  border-radius: 12rpx;
  padding: 20rpx;
  min-height: 140rpx;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  background: #fff;
  line-height: 1.5;
}

.goods-hit {
  border-top: 1rpx solid #edf2f7;
  padding: 18rpx 0;
}
.goods-hit:active {
  background: #f3f6fb;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1e293b;
}

.goods-row {
  display: flex;
  align-items: center;
  border-top: 1rpx solid #edf2f7;
  padding: 18rpx 0;
}
.goods-main {
  flex: 1;
  margin-right: 16rpx;
  min-width: 0;
}
.qty-input {
  width: 160rpx;
  border: 1rpx solid #d8e0ea;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
  background: #fff;
}
.del {
  color: #dc2626;
  font-size: 26rpx;
  padding: 8rpx 4rpx;
}

.hint {
  color: #64748b;
  font-size: 24rpx;
  padding: 12rpx 0;
}
.error {
  color: #dc2626;
  font-size: 24rpx;
  padding: 12rpx 0;
}
.muted {
  color: #94a3b8;
  font-size: 24rpx;
}

.submit-btn {
  margin-top: 8rpx;
}
