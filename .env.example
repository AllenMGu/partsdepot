# ===== 多仓库管理系统 环境变量示例 =====
# 复制为 .env（或直接通过进程环境注入），.env 文件不要提交到版本库。

# ---- 必填 ----
# JWT 签名密钥：必须为长随机串（可用 `python3 -c "import secrets;print(secrets.token_urlsafe(48))"` 生成）。
# 未设置时系统会使用一次性随机密钥（重启后所有已发 token 失效），生产环境务必显式设置。
SECRET_KEY=replace-with-a-long-random-value

# 数据库连接串。PostgreSQL 生产部署示例：
DATABASE_URL=postgresql://warehouse_user:change-me@localhost:5432/warehouse_db
# 本地快速试用（SQLite）：
# DATABASE_URL=sqlite:///./warehouse.db

# ---- 初始管理员自举（首次部署建议设置；创建成功后即可移除）----
# 系统无任何用户且设置了这两个变量时，启动自动创建管理员并授权所有现有仓库。
# 不要使用弱口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ---- 可选 ----
# JWT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS 允许来源（逗号分隔，按实际前端地址填写）
CORS_ORIGINS=http://localhost:8000

# ---- LDAP（可选，启用后登录走 LDAP 绑定校验）----
# 代码不含任何内置默认值：server/Base DN/搜索过滤器任一缺失时 LDAP 登录不可用。
# 搜索过滤器必须包含 {} 占位符，建议叠加群组限制（避免匹配到任意用户）：
LDAP_SERVER=ldap://<ldap-host>:389
LDAP_BASE_DN=dc=<domain>,dc=com
LDAP_ADMIN_DN=
LDAP_ADMIN_PASSWORD=
LDAP_USER_SEARCH_FILTER=(&(sAMAccountName={})(memberOf=CN=<WMS-Users>,OU=Groups,DC=<domain>,DC=com))
